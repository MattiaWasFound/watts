<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Unity package's Core, built the way Unity sees it: netstandard2.1, C# 9. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>Watts</AssemblyName>
    <RootNamespace>Watts</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
    <!-- NuGet: the same core for any .NET host (Godot C#, Stride, desktop apps, tools). -->
    <PackageId>Watts</PackageId>
    <Version>0.2.0</Version>
    <Authors>Mattia</Authors>
    <Description>Work in progress. An estimate of how much power this computer draws right now at the wall, in watts, plus the session's watt-hours and whether the figure was measured or estimated. macOS, Windows and Linux; no admin rights, no network, no native binaries.</Description>
    <PackageTags>power;energy;watts;battery;rapl;nvml;smc;sustainability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MattiaWasFound/watts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MattiaWasFound/watts</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../unity/Watts/Core/**/*.cs" />
  </ItemGroup>
</Project>
